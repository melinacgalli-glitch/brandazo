{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.brandazo.com.ar/schemas/integrations/error.v1.json",
  "title": "Error de integración",
  "description": "Formato único de error para todos los endpoints de integración de Brandazo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "requestId",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_JSON",
            "UNSUPPORTED_MEDIA_TYPE",
            "PAYLOAD_TOO_LARGE",
            "METHOD_NOT_ALLOWED",
            "NOT_FOUND",
            "MISSING_SIGNATURE",
            "UNKNOWN_KEY",
            "INVALID_SIGNATURE",
            "TIMESTAMP_OUT_OF_RANGE",
            "MISSING_IDEMPOTENCY_KEY",
            "IDEMPOTENCY_KEY_MISMATCH",
            "IDEMPOTENCY_CONFLICT",
            "REQUEST_IN_PROGRESS",
            "VALIDATION_FAILED",
            "EVENT_DATE_IN_PAST",
            "RATE_LIMITED",
            "INTERNAL_ERROR",
            "UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "description": "Explicación en español, para el registro técnico (no para mostrar a la persona)."
        },
        "requestId": {
          "type": "string",
          "description": "Identificador del intento; pasarlo al reportar un problema."
        },
        "retryable": {
          "type": "boolean",
          "description": "true = reintentar con el MISMO cuerpo e Idempotency-Key (firma y timestamp nuevos)."
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "issue"
            ],
            "properties": {
              "field": {
                "type": "string",
                "description": "Ruta del campo, ej.: event.guests"
              },
              "issue": {
                "type": "string",
                "description": "Qué está mal, ej.: «debe ser al menos 60»."
              }
            }
          }
        }
      }
    }
  }
}
