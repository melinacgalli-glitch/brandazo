rules_version = '2';
// Brandazo · Etapa de integración: la base solo la usa el servidor (Admin SDK), que no pasa por estas reglas.
// Desde el navegador no se puede leer ni escribir nada hasta que exista el ingreso real con roles (Etapa 0),
// donde cada usuario verá solo los datos de su empresa (tenants/{tenantId}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
