rules_version = '2';
// Reglas de Brandazo (Etapa 0). Cada empresa es tenants/{tenantId}; solo sus miembros la ven.
// Lo que escribe el servidor (cotizaciones, contactos, índices, idempotencia, límites, registro técnico)
// no se puede crear ni borrar desde el navegador. Pruebas: rules-test/ (npm test con el emulador).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function memberPath(t) { return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid); }
    function isMember(t) { return signedIn() && exists(memberPath(t)); }
    function myRole(t) { return get(memberPath(t)).data.role; }
    function isAdmin(t) { return isMember(t) && myRole(t) in ['Dueño', 'Admin']; }
    function isPlatformAdmin() {
      return verified() && myEmail() in get(/databases/$(database)/documents/config/platform).data.admins;
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function teamRole(r) { return r in ['Admin', 'Marketing', 'Ventas', 'Atención']; }

    // Administradores de la plataforma (lo carga el script de alta, nunca el navegador)
    match /config/platform {
      allow get: if verified() && myEmail() in resource.data.admins;
      allow write: if false;
    }

    // Invitaciones: id = "<email>__<tenantId>"
    match /invites/{inviteId} {
      allow read: if (verified() && resource.data.email == myEmail()) || isAdmin(resource.data.tenantId);
      allow create: if isAdmin(request.resource.data.tenantId)
        && inviteId == request.resource.data.email + '__' + request.resource.data.tenantId
        && request.resource.data.email == request.resource.data.email.lower()
        && teamRole(request.resource.data.role)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'tenantId', 'tenantName', 'role', 'invitedBy', 'invitedByName', 'createdAt']);
      allow update: if isAdmin(resource.data.tenantId) && onlyChanges(['role']) && teamRole(request.resource.data.role);
      allow delete: if isAdmin(resource.data.tenantId) || (verified() && resource.data.email == myEmail());
    }

    // Búsqueda de "mis empresas" (collectionGroup members where uid == yo)
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /tenants/{t} {
      allow get: if isMember(t);
      allow create: if isPlatformAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin(t) && onlyChanges(['name', 'country', 'industry', 'size', 'updatedAt']);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(t);
        // Alta: aceptando una invitación propia y verificada, o el creador de la empresa como Dueño
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.email == myEmail()
          && (
            (verified()
              && exists(/databases/$(database)/documents/invites/$(myEmail() + '__' + t))
              && get(/databases/$(database)/documents/invites/$(myEmail() + '__' + t)).data.role == request.resource.data.role)
            || (request.resource.data.role == 'Dueño' && get(/databases/$(database)/documents/tenants/$(t)).data.ownerUid == request.auth.uid)
          );
        // Cambiar rol: Dueño/Admin, nunca hacia o desde Dueño (eso es "transferir la propiedad")
        allow update: if isAdmin(t) && onlyChanges(['role']) && teamRole(request.resource.data.role) && resource.data.role != 'Dueño';
        // Quitar: Dueño/Admin (no al Dueño), o la persona misma salvo que sea Dueño
        allow delete: if resource.data.role != 'Dueño' && (isAdmin(t) || uid == request.auth.uid);
      }

      // Datos de la empresa guardados desde la app (JSON por partes)
      match /state/{part} {
        allow read: if isMember(t);
        allow write: if isMember(t)
          && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'by'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 1000000
          && request.resource.data.by == request.auth.uid;
      }

      // Cotizaciones convertidas en oportunidades: el equipo solo mueve el seguimiento
      match /opportunities/{o} {
        allow read: if isMember(t);
        allow update: if isMember(t)
          && onlyChanges(['stage', 'owner', 'lostReason', 'lostNote', 'canRecontact', 'nextFollowUpAt', 'nextAction', 'updatedAt', 'stageHistory', 'proposal', 'won', 'negotiation', 'campaignId'])
          && (!('campaignId' in request.resource.data) || request.resource.data.campaignId == null || (request.resource.data.campaignId is string && request.resource.data.campaignId.size() <= 64))
          && (!('nextAction' in request.resource.data) || request.resource.data.nextAction == null || (request.resource.data.nextAction is string && request.resource.data.nextAction.size() <= 200))
          && request.resource.data.stage in ['nueva-cotizacion', 'contactado', 'en-negociacion', 'ganada', 'perdida']
          && (request.resource.data.stage != 'perdida' || request.resource.data.lostReason is string)
          && request.resource.data.owner is string
          // Datos mínimos de cada etapa (importes en centavos, enteros)
          // Importe actualizado (en negociación): opcional, pero si está tiene que ser un importe válido
          && (!('proposal' in request.resource.data) || request.resource.data.proposal == null || (request.resource.data.proposal.amountMinor is int && request.resource.data.proposal.amountMinor > 0))
          && (request.resource.data.stage != 'ganada' || (request.resource.data.won.amountMinor is int && request.resource.data.won.amountMinor > 0
                && request.resource.data.won.depositMinor is int && request.resource.data.won.depositMinor >= 0 && request.resource.data.won.depositMinor <= request.resource.data.won.amountMinor))
          && (!(request.resource.data.stage in ['contactado', 'en-negociacion']) || request.resource.data.nextFollowUpAt is timestamp);
        allow create, delete: if false;
      }

      match /settings/{s} {
        allow read: if isMember(t);
        // Qué marca corresponde a cada cuenta conectada
        allow write: if isAdmin(t) && s == 'social'
          && request.resource.data.keys().hasOnly(['brandByAccount', 'updatedAt', 'updatedBy'])
          && request.resource.data.brandByAccount is map;
        allow write: if isAdmin(t) && s == 'cafelito-eventos'
          && request.resource.data.keys().hasOnly(['brand', 'defaultOwner', 'assignByEventType', 'followUpHours', 'blockedDates', 'dailyCapacity', 'minNoticeDays', 'updatedAt', 'updatedBy'])
          && (!('blockedDates' in request.resource.data) || (request.resource.data.blockedDates is list && request.resource.data.blockedDates.size() <= 366))
          && (!('followUpHours' in request.resource.data) || (request.resource.data.followUpHours is int && request.resource.data.followUpHours >= 1 && request.resource.data.followUpHours <= 168));
      }

      // Historia de cada cotización: se agrega a nombre propio, no se edita ni se borra
      match /activities/{a} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && request.resource.data.opportunityId is string
          && request.resource.data.type in ['etapa', 'contacto', 'nota', 'cobro', 'cambio']
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /audit/{a} {
        allow read: if isAdmin(t);
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }

      // Solo lectura para el equipo; las escribe el servidor
      match /contacts/{id} { allow read: if isMember(t); allow write: if false; }
      match /eventQuotes/{id} { allow read: if isMember(t); allow write: if false; }
      match /orders/{id} { allow read: if isMember(t); allow write: if false; } // pedidos de la tienda: solo los escribe el servidor
      match /subscriptions/{id} { allow read: if isMember(t); allow write: if false; } // suscripciones (Work): solo el servidor
      match /enrollments/{id} { allow read: if isMember(t); allow write: if false; } // inscripciones (Academy): solo el servidor
      match /contactEvents/{id} { allow read: if isMember(t); allow write: if false; } // lo que cada contacto pidió desde la web
      match /coupons/{id} { allow read: if isMember(t); allow write: if false; } // códigos de descuento: los crea y canjea el servidor
      match /mailings/{id} { allow read: if isMember(t); allow write: if false; }   // envíos a segmentos: los arma y manda el servidor
      match /mailSends/{id} { allow read: if isMember(t); allow write: if false; }  // uno por persona y envío
      match /mailTests/{id} { allow read, write: if false; }                         // pruebas hechas (solo el servidor)
      match /autoSends/{id} { allow read: if isMember(t); allow write: if false; } // mails enviados por automatizaciones
      match /tasks/{id} {
        allow read: if isMember(t);
        // El equipo solo marca la tarea como hecha
        allow update: if isMember(t) && onlyChanges(['status', 'doneAt', 'doneBy', 'doneByName'])
          && request.resource.data.status == 'hecha' && request.resource.data.doneBy == request.auth.uid;
        allow create, delete: if false;
      }
      match /notifications/{id} { allow read: if isMember(t); allow write: if false; }
      match /pipelines/{id} { allow read: if isMember(t); allow write: if false; }
      // Redes y anuncios conectados (los escribe el servidor). Los permisos de acceso van en private/*: nunca se leen desde el navegador.
      match /connections/{id} { allow read: if isMember(t); allow write: if false; }
      match /social/{id} { allow read: if isMember(t); allow write: if false; }
      match /socialDaily/{id} { allow read: if isMember(t); allow write: if false; }
      match /ads/{id} { allow read: if isMember(t); allow write: if false; }
      match /private/{id} { allow read, write: if false; }
      // contactsByPhone, contactsByEmail, idempotency, rateLimits, integrationLog, connectStates: sin acceso desde el navegador
    }
  }
}
